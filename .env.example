# Database
DATABASE_URL="file:./dev.db"

# Groq LLM (server-only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight by Vectorize (server-only)
# Cloud: https://api.hindsight.vectorize.io
# Local: http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=opshindsight-incidents

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# DEMO_MODE=true  → local DemoMemory only (no real Hindsight calls)
# DEMO_MODE=false → real Hindsight retain/recall/reflect (requires HINDSIGHT_API_KEY)
DEMO_MODE=false
