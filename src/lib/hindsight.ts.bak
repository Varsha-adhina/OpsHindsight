import { prisma } from "./db";
import { isDemoMode, hasHindsightKey } from "./utils";
import type {
  HindsightMemory,
  RetainInput,
  RecallInput,
  ReflectInput,
  MemoryTrace,
} from "@/types";

const BASE_URL = process.env.HINDSIGHT_BASE_URL || "https://api.hindsight.vectorize.io";
const API_KEY = process.env.HINDSIGHT_API_KEY || "";
const BANK_ID = process.env.HINDSIGHT_BANK_ID || "opshindsight-incidents";

export type HindsightMode = "live" | "demo" | "fallback";

function getMode(): HindsightMode {
  if (isDemoMode() || !hasHindsightKey()) return "demo";
  return "live";
}

async function liveFetch(
  path: string,
  options: RequestInit = {},
  timeoutMs = 15000
): Promise<Response> {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const res = await fetch(`${BASE_URL}${path}`, {
      ...options,
      signal: controller.signal,
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${API_KEY}`,
        "X-Bank-Id": BANK_ID,
        ...(options.headers || {}),
      },
    });
    return res;
  } finally {
    clearTimeout(timer);
  }
}

export async function getMemoryStatus(): Promise<{
  connected: boolean;
  mode: HindsightMode;
  bankId: string;
  totalMemories: number;
  message: string;
}> {
  const mode = getMode();
  if (mode === "demo") {
    const count = await prisma.demoMemory.count();
    return {
      connected: true,
      mode: "demo",
      bankId: BANK_ID,
      totalMemories: count,
      message: "Running in Demo Mode with seeded Hindsight memories",
    };
  }
  try {
    const res = await liveFetch(`/v1/banks/${BANK_ID}/status`, { method: "GET" }, 8000);
    if (!res.ok) throw new Error(`Status ${res.status}`);
    const data = await res.json();
    return {
      connected: true,
      mode: "live",
      bankId: BANK_ID,
      totalMemories: data.memoryCount ?? data.count ?? 0,
      message: "Connected to Hindsight",
    };
  } catch (e) {
    const count = await prisma.demoMemory.count();
    return {
      connected: false,
      mode: "fallback",
      bankId: BANK_ID,
      totalMemories: count,
      message: `Hindsight unavailable: ${e instanceof Error ? e.message : "unknown"}. Using local seeded memories.`,
    };
  }
}

export async function retainMemory(
  input: RetainInput
): Promise<{ success: boolean; memoryId?: string; durationMs: number; mode: HindsightMode; error?: string }> {
  const start = Date.now();
  const mode = getMode();
  const memoryId = `mem_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;

  try {
    if (mode === "live") {
      const res = await liveFetch(`/v1/banks/${BANK_ID}/retain`, {
        method: "POST",
        body: JSON.stringify({
          content: input.content,
          metadata: input.metadata || {},
        }),
      });
      if (!res.ok) {
        const text = await res.text();
        throw new Error(`Retain failed: ${res.status} ${text}`);
      }
      const data = await res.json();
      // also mirror to local for explorer
      await prisma.demoMemory.upsert({
        where: { memoryId: data.id || memoryId },
        create: {
          memoryId: data.id || memoryId,
          content: input.content,
          service: (input.metadata?.service as string) || null,
          category: (input.metadata?.category as string) || "incident",
          metadata: JSON.stringify(input.metadata || {}),
        },
        update: { content: input.content },
      });
      return { success: true, memoryId: data.id || memoryId, durationMs: Date.now() - start, mode };
    }

    // Demo / fallback: store in SQLite DemoMemory
    await prisma.demoMemory.upsert({
      where: { memoryId },
      create: {
        memoryId,
        content: input.content,
        service: (input.metadata?.service as string) || null,
        category: (input.metadata?.category as string) || "incident",
        metadata: JSON.stringify(input.metadata || {}),
      },
      update: { content: input.content },
    });
    return { success: true, memoryId, durationMs: Date.now() - start, mode };
  } catch (e) {
    return {
      success: false,
      durationMs: Date.now() - start,
      mode: "fallback",
      error: e instanceof Error ? e.message : "retain failed",
    };
  }
}

export async function recallMemories(
  input: RecallInput
): Promise<{ memories: HindsightMemory[]; durationMs: number; mode: HindsightMode; error?: string }> {
  const start = Date.now();
  const mode = getMode();
  const limit = input.limit ?? 8;

  try {
    if (mode === "live") {
      const res = await liveFetch(`/v1/banks/${BANK_ID}/recall`, {
        method: "POST",
        body: JSON.stringify({
          query: input.query,
          limit,
          filters: input.filters || {},
        }),
      });
      if (!res.ok) throw new Error(`Recall failed: ${res.status}`);
      const data = await res.json();
      const memories: HindsightMemory[] = (data.memories || data.results || []).map(
        (m: Record<string, unknown>, i: number) => ({
          id: (m.id as string) || `live_${i}`,
          content: (m.content as string) || (m.text as string) || "",
          score: (m.score as number) || (m.relevance as number) || 0.5,
          metadata: (m.metadata as Record<string, unknown>) || {},
        })
      );
      return { memories, durationMs: Date.now() - start, mode };
    }

    // Demo mode: keyword search over seeded DemoMemory
    const all = await prisma.demoMemory.findMany({ orderBy: { createdAt: "desc" }, take: 100 });
    const queryLower = input.query.toLowerCase();
    const tokens = queryLower.split(/\s+/).filter((t) => t.length > 2);

    const scored = all
      .map((m) => {
        const contentLower = m.content.toLowerCase();
        let score = 0;
        for (const t of tokens) {
          if (contentLower.includes(t)) score += 1;
        }
        if (input.filters?.service && m.service === input.filters.service) score += 3;
        return { memory: m, score };
      })
      .filter((s) => s.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, limit);

    const memories: HindsightMemory[] = scored.map((s) => ({
      id: s.memory.memoryId,
      content: s.memory.content,
      score: Math.min(1, s.score / (tokens.length + 3)),
      metadata: s.memory.metadata ? JSON.parse(s.memory.metadata) : {},
      createdAt: s.memory.createdAt.toISOString(),
    }));

    return { memories, durationMs: Date.now() - start, mode };
  } catch (e) {
    return {
      memories: [],
      durationMs: Date.now() - start,
      mode: "fallback",
      error: e instanceof Error ? e.message : "recall failed",
    };
  }
}

export async function reflectOnIncident(
  input: ReflectInput
): Promise<{ reflection: string; durationMs: number; mode: HindsightMode }> {
  // Reflect is primarily LLM synthesis over recalled memories.
  // This function prepares a structured context string for the agent.
  const start = Date.now();
  const mode = getMode();
  const parts: string[] = [];
  parts.push("=== CURRENT INCIDENT ===");
  parts.push(JSON.stringify(input.incident, null, 2));
  if (input.timeline?.length) {
    parts.push("\n=== TIMELINE ===");
    parts.push(input.timeline.join("\n"));
  }
  if (input.observations?.length) {
    parts.push("\n=== OBSERVATIONS ===");
    parts.push(input.observations.join("\n"));
  }
  parts.push("\n=== RECALLED HINDSIGHT MEMORIES ===");
  if (input.memories.length === 0) {
    parts.push("No relevant historical memories found.");
  } else {
    input.memories.forEach((m, i) => {
      parts.push(`\n[Memory ${i + 1} id=${m.id} score=${m.score?.toFixed(2) ?? "n/a"}]`);
      parts.push(m.content);
    });
  }
  return {
    reflection: parts.join("\n"),
    durationMs: Date.now() - start,
    mode,
  };
}

export async function seedMemories(
  items: { memoryId: string; content: string; service?: string; category?: string }[]
): Promise<{ seeded: number; skipped: number }> {
  let seeded = 0;
  let skipped = 0;
  for (const item of items) {
    const existing = await prisma.demoMemory.findUnique({ where: { memoryId: item.memoryId } });
    if (existing) {
      skipped++;
      continue;
    }
    await prisma.demoMemory.create({
      data: {
        memoryId: item.memoryId,
        content: item.content,
        service: item.service || null,
        category: item.category || "incident",
      },
    });
    seeded++;
  }
  return { seeded, skipped };
}

export { BANK_ID, getMode };
